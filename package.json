{
	"name": "@tsuuanmi/provider",
	"displayName": "Account",
	"description": "Multi-account provider management for DeepSeek Harness: a GUI dropdown to switch active accounts, plus OAuth/API-key add and remove.",
	"version": "0.1.0-alpha.2",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsuuanmi/provider.git"
	},
	"homepage": "https://github.com/tsuuanmi/provider",
	"bugs": {
		"url": "https://github.com/tsuuanmi/provider/issues"
	},
	"keywords": [
		"dsh-plugin",
		"deepseek-harness",
		"account",
		"oauth",
		"openai-codex"
	],
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./client": "./lib/client.js",
		"./invariant": {
			"types": "./lib/invariant.d.ts",
			"default": "./lib/invariant.js"
		},
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-client-runtime",
				"@deepseek-ai/dsh-client-connection",
				"@deepseek-ai/dsh-client-ui-slots",
				"@deepseek-ai/dsh-client-locale"
			],
			"platform": "web"
		}
	},
	"scripts": {
		"build": "tsdown && node scripts/build-client.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"check": "pnpm run typecheck && pnpm run build && pnpm run test"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "0.82.1",
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
		"@deepseek-ai/dsh-brand": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
		"@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
		"@deepseek-ai/dsh-home-paths": "0.1.0-rc.7",
		"@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.7",
		"@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
		"@deepseek-ai/dsh-llm": "0.1.0-rc.7",
		"@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.7",
		"@deepseek-ai/dsh-settings": "0.1.0-rc.7",
		"clsx": "^2.1.1",
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.82.1",
		"@deepseek-ai/cordis": "^4.0.1",
		"@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
		"@deepseek-ai/dsh-brand": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
		"@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
		"@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
		"@deepseek-ai/dsh-home-paths": "0.1.0-rc.7",
		"@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.7",
		"@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
		"@deepseek-ai/dsh-llm": "0.1.0-rc.7",
		"@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.7",
		"@deepseek-ai/dsh-settings": "0.1.0-rc.7",
		"@deepseek-ai/schemastery": "^3.18.1",
		"@types/node": "^22.20.0",
		"@types/react": "~18.3.1",
		"clsx": "^2.1.1",
		"esbuild": "^0.25.0",
		"react": "^18.2.0",
		"tsdown": "^0.22.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8"
	},
	"engines": {
		"node": "^22.19.0 || >=24.0.0"
	}
}
